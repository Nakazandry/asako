PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# En local
DATABASE_URL=postgresql://postgres:123456@localhost:5432/asako
# En production (Render/Neon), utiliser la chaine fournie par la base
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

JWT_SECRET=change_me_before_production
JWT_EXPIRES_IN=7d

# Notifications e-mail (Resend)
# Creer une cle sur https://resend.com/api-keys puis la renseigner uniquement ici.
RESEND_API_KEY=re_votre_cle_reelle
# Expediteur. onboarding@resend.dev = mode TEST Resend : la livraison n'est
# acceptee que vers l'adresse du compte Resend. Pour ecrire aux candidats,
# verifier un domaine sur https://resend.com/domains et utiliser une adresse
# de ce domaine (ex: EMAIL_FROM="ASAKO <no-reply@votre-domaine.com>").
EMAIL_FROM=ASAKO <onboarding@resend.dev>
# URL publique du frontend utilisee dans les liens des e-mails.
# Local : http://localhost:5173 | Production : https://asako-beta.vercel.app
FRONTEND_URL=http://localhost:5173
# Utilise par CORS cote backend (aligner sur FRONTEND_URL).
CLIENT_URL=http://localhost:5173

# --- Redirection de DEMONSTRATION (optionnelle, desactivee par defaut) ---
# Lorsqu'elle est activee, TOUS les e-mails (candidats + administrateurs) sont
# envoyes a EMAIL_DEMO_REDIRECT_TO. Aucun compte, identifiant ou mot de passe
# n'est modifie. A laisser sur false en production hors demonstration.
# En production il faut explicitement EMAIL_DEMO_REDIRECT_ENABLED=true.
EMAIL_DEMO_REDIRECT_ENABLED=false
EMAIL_DEMO_REDIRECT_TO=
