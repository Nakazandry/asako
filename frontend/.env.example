# URL de l'API backend. En local :
VITE_API_URL=http://localhost:5000/api
# Sur Vercel, definir cette variable dans Settings > Environment Variables :
# VITE_API_URL=https://asako-xipm.onrender.com/api
#
# Ne jamais placer ici RESEND_API_KEY, JWT_SECRET ou un mot de passe :
# seules les variables VITE_* sont embarquees dans le bundle frontend.
